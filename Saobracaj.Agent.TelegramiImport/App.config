<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Saobracaj.Agent.TelegramiImport — podešavanja.
    LOZINKE SE NE UPISUJU U OVAJ FAJL U OTVORENOM TEKSTU. Vidi README.md, odeljak "Lozinke".
  -->
  <connectionStrings>
    <!-- Preporučeno: Integrated Security pod servisnim nalogom (bez lozinke).
         Sa SQL nalogom: ...;User ID=<nalog>;Password={SqlLozinka}  i  SqlLozinka.dpapi ispod. -->
    <add name="Telegrami" connectionString="Data Source=192.168.1.6\SQLEXPRESS2008K;Initial Catalog=Perftech2;Integrated Security=True;Application Name=Saobracaj.Agent.TelegramiImport" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="ImapHost" value="mail.kprevoz.co.rs" />
    <add key="ImapPort" value="993" />
    <add key="ImapSsl" value="true" />
    <add key="ImapKorisnik" value="telegrami@kprevoz.co.rs" />
    <add key="ImapFolder" value="INBOX" />
    <!-- <add key="ImapLozinka.dpapi" value="(izlaz komande: Saobracaj.Agent.TelegramiImport.exe zastiti lozinku)" /> -->
    <!-- <add key="SqlLozinka.dpapi" value="..." /> -->
    <!-- CurrentUser (podrazumevano) ili LocalMachine -->
    <add key="DpapiOpseg" value="CurrentUser" />

    <!-- Prvo pokretanje: poruke od ovog datuma -->
    <add key="ImportOd" value="2026-11-01" />
    <!-- true = sve se parsira i loguje, ništa se ne upisuje. Podrazumevano UKLJUČENO pri prvom puštanju. -->
    <add key="DryRun" value="true" />
    <!-- Prazno = folder "logs" pored exe-a -->
    <add key="LogFolder" value="" />
    <!-- Folder za PDF-ove kao u ručnom unosu (kolona Telegrami.PDF). Prazno = PDF samo u bazi (TelegramiPrilozi). -->
    <add key="PdfFolder" value="" />
    <!-- Redovi sa VaziDo < sada → Aktivan = 0 -->
    <add key="GasiIstekle" value="true" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.2" />
  </startup>
  <runtime>
    <!-- Ako se exe pokreće sa UNC putanje (\\server\share\...): -->
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
