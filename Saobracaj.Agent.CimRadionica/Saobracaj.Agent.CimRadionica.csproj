<Project Sdk="Microsoft.NET.Sdk">

  <!--
    v3.0: CimRadionica – samostalan WinForms alat za testiranje agenta CimProvera (isto jezgro, nikad ne šalje mail).
    Uvoz .msg/.eml/foldera/.zip, obrada (delovi od po 20 poruka u posebnim procesima), rezultati po mailu, Zbirni Excel,
    poređenje verzija, pregled pravila, poslova i teretnica, online/offline, paket za analizu, praćenje foldera Testiranje.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net462</TargetFramework>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x86</PlatformTarget>
    <RootNamespace>Saobracaj.Agent.CimRadionica</RootNamespace>
    <AssemblyName>CimRadionica</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>3.0.0</Version>
    <Product>CimRadionica</Product>
    <Company>Kombinovani prevoz d.o.o.</Company>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Security" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <None Include="App.config" />
  </ItemGroup>

  <ItemGroup>
    <!-- isti paketi kao agent: nativne biblioteke (Pdfium, Tesseract) se kopiraju samo iz direktne reference paketa -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="MailKit" Version="4.15.1" />
    <PackageReference Include="PdfiumViewer" Version="2.13.0" />
    <PackageReference Include="PdfiumViewer.Native.x86.v8-xfa" Version="2018.4.8.256" />
    <PackageReference Include="PdfiumViewer.Native.x86_64.v8-xfa" Version="2018.4.8.256" />
    <PackageReference Include="PdfPig" Version="0.1.11" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="ExcelDataReader" Version="3.7.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.7.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <PackageReference Include="MsgReader" Version="5.7.1" />
    <PackageReference Include="Syncfusion.DocToPDFConverter.WinForms" Version="18.4.0.34" />
    <PackageReference Include="Syncfusion.Licensing" Version="18.4.0.34" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Saobracaj.Common\Saobracaj.Common.csproj" />
    <ProjectReference Include="..\Saobracaj.Agent.CimProvera.Jezgro\Saobracaj.Agent.CimProvera.Jezgro.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Instaliraj-CimRadionica.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Uputstvo.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
