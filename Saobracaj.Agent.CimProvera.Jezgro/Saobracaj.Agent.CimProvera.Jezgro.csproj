<Project Sdk="Microsoft.NET.Sdk">

  <!--
    v3.0: jezgro CimProvera – klasifikacija, OCR, pravila, PRIMER, odgovor, dosije, upis poslova, tok obrade poruke.
    Koriste ga dve ljuske: agent (Saobracaj.Agent.CimProvera – IMAP/SMTP, zakazani rad) i CimRadionica (WinForms alat).
    Nijedno pravilo, parser ni generator ne postoji u dve kopije. Namespace-ovi su isti kao ranije (Saobracaj.Agent.CimProvera.*).
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net462</TargetFramework>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x86</PlatformTarget>
    <RootNamespace>Saobracaj.Agent.CimProvera</RootNamespace>
    <AssemblyName>Saobracaj.Agent.CimProvera.Jezgro</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>3.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Samo JSON: na Windows-u "pravila" i izvorni folder "Pravila" su isti folder. Kopira se i u izlaz agenta, alata i testova. -->
    <None Include="pravila\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="sablon\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="sablon\obrasci\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Tesseract jezici (tessdata_fast, Apache 2.0); preuzimanje: tessdata\Preuzmi.ps1. -->
    <None Include="tessdata\*.traineddata" CopyToOutputDirectory="PreserveNewest" />
    <None Include="tessdata\Preuzmi.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Security" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="MailKit" Version="4.15.1" />
    <PackageReference Include="PdfiumViewer" Version="2.13.0" />
    <PackageReference Include="PdfiumViewer.Native.x86.v8-xfa" Version="2018.4.8.256" />
    <PackageReference Include="PdfiumViewer.Native.x86_64.v8-xfa" Version="2018.4.8.256" />
    <PackageReference Include="PdfPig" Version="0.1.11" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="ExcelDataReader" Version="3.7.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.7.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <PackageReference Include="MsgReader" Version="5.7.1" />
    <!-- Word → PDF (DocIO, isti major 18.x kao aplikacija Saobracaj; ključ iz Syncfusion.dpapi, nikad u kodu) -->
    <PackageReference Include="Syncfusion.DocToPDFConverter.WinForms" Version="18.4.0.34" />
    <PackageReference Include="Syncfusion.Licensing" Version="18.4.0.34" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Saobracaj.Common\Saobracaj.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Saobracaj.Agent.CimProvera" />
    <InternalsVisibleTo Include="Saobracaj.Agent.CimRadionica" />
    <InternalsVisibleTo Include="Saobracaj.Agent.CimProvera.Tests" />
  </ItemGroup>

</Project>
