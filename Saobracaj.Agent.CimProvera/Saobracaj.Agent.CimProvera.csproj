<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net462 kao TelegramiImport (SQL Server 2008 R2 / TLS 1.0 na serveru). -->
    <TargetFramework>net462</TargetFramework>
    <!-- v2.9.2 (3a.6): podrazumevano x86; x64: dotnet build -c Release -p:PlatformTarget=x64 -p:OutputPath=bin\Release-x64\ -p:IntermediateOutputPath=obj\Release-x64\ -->
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x86</PlatformTarget>
    <RootNamespace>Saobracaj.Agent.CimProvera</RootNamespace>
    <AssemblyName>Saobracaj.Agent.CimProvera</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- verzija programa; v2.9.0: upis u planiranje.tmp* (pravila ostaju 2.8.4, meta.version u cim_validation_rules.json) -->
    <Version>3.0.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- v3.0: pravila, šabloni i tessdata su u jezgru (Saobracaj.Agent.CimProvera.Jezgro) i kopiraju se u izlaz agenta odatle. -->
    <None Include="Instaliraj.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Reset-CimProvera.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Security" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="MailKit" Version="4.15.1" />
    <PackageReference Include="PdfiumViewer" Version="2.13.0" />
    <PackageReference Include="PdfiumViewer.Native.x86.v8-xfa" Version="2018.4.8.256" />
    <PackageReference Include="PdfiumViewer.Native.x86_64.v8-xfa" Version="2018.4.8.256" />
    <PackageReference Include="PdfPig" Version="0.1.11" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="ExcelDataReader" Version="3.7.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.7.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <PackageReference Include="MsgReader" Version="5.7.1" />
    <!-- Word → PDF (DocIO, isti major 18.x kao aplikacija Saobracaj; ključ iz Syncfusion.dpapi, nikad u kodu) -->
    <PackageReference Include="Syncfusion.DocToPDFConverter.WinForms" Version="18.4.0.34" />
    <PackageReference Include="Syncfusion.Licensing" Version="18.4.0.34" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Saobracaj.Common\Saobracaj.Common.csproj" />
    <ProjectReference Include="..\Saobracaj.Agent.CimProvera.Jezgro\Saobracaj.Agent.CimProvera.Jezgro.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Saobracaj.Agent.CimProvera.Tests" />
  </ItemGroup>

</Project>
