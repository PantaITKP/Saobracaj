<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Saobracaj.Agent.CimProvera – podešavanja (Saobracaj.Agent.CimProvera.exe.config pored exe-a).
    LOZINKE I API KLJUČ SE NE UPISUJU U OTVORENOM TEKSTU: samo *.dpapi vrednosti (komanda "zastiti", pod nalogom koji
    pokreće agent) ili promenljive okruženja CIMPROVERA_LOZINKA / ANTHROPIC_API_KEY.
  -->
  <appSettings>
    <!-- ===== Mail: sanduče koje agent čita (INBOX = dolazni, Sent = odlazni). Za produkciju promeniti ovde. ===== -->
    <!-- CitajSanduce = sanduče koje se čita i nalog za IMAP/SMTP prijavu (stari ključ: Nalog) -->
    <add key="CitajSanduce" value="agenti@kprevoz.co.rs" />
    <!-- <add key="Lozinka.dpapi" value="(izlaz: Saobracaj.Agent.CimProvera.exe - -zastiti <lozinka>)" /> -->
    <add key="ImapHost" value="mail.kprevoz.co.rs" />
    <add key="ImapPort" value="993" />
    <add key="ImapSsl" value="true" />
    <add key="SmtpHost" value="mail.kprevoz.co.rs" />
    <add key="SmtpPort" value="465" />
    <add key="SmtpSsl" value="true" />
    <add key="DolazniFolder" value="INBOX" />
    <!-- Prazno = folder "Sent" sa servera (SPECIAL-USE), ili upisati tačan naziv, npr. INBOX.Sent -->
    <add key="OdlazniFolder" value="" />
    <add key="CitajOdlazne" value="true" />
    <!-- From i Reply-To odgovora agenta; prazno = CitajSanduce (stari ključ: PosiljalacIzvestaja) -->
    <add key="From" value="agenti@kprevoz.co.rs" />
    <add key="ReplyTo" value="agenti@kprevoz.co.rs" />

    <!-- ===== Režim: Test = svi izveštaji idu SAMO na IzvestajAdresa; Live = dolazni → odgovor pošiljaocu, odlazni → pošiljaocu (sebi) ===== -->
    <add key="Rezim" value="Test" />
    <!-- TestPrimalac: u režimu Test svi odgovori idu samo ovde (stari ključ: IzvestajAdresa) -->
    <add key="TestPrimalac" value="agenti@kprevoz.co.rs" />
    <!-- Live: kopija odgovora na dolazni mail (npr. priprema@kprevoz.co.rs), više adresa razdvojiti zarezom -->
    <add key="KopijaNa" value="" />
    <add key="InterniDomeni" value="kprevoz.co.rs" />
    <add key="OdgovoriNaIspravanDolazni" value="true" />
    <add key="ObavestiIspravanOdlazni" value="false" />
    <!-- Kratka potvrda pošiljaocu "tovarni list je ispravan" (umesto punog izveštaja) – za sada isključeno -->
    <add key="PotvrdaIspravnogDolaznog" value="false" />
    <!-- Potpis u mailu sa izveštajem: ime i telefon (prazno ime = potpis počinje sa PotpisOdeljenje) -->
    <add key="PotpisIme" value="" />
    <add key="PotpisTelefon" value="" />
    <add key="PotpisOdeljenje" value="Priprema saobraćaja" />
    <add key="PotpisEmail" value="priprema@kprevoz.co.rs" />
    <!-- Prvo pokretanje: poruke od ovog datuma -->
    <add key="ImportOd" value="2026-11-10" />
    <!-- Upozorenja o radu agenta (nedostupan server, istekla lozinka…); prazno = IzvestajAdresa -->
    <add key="UpozorenjaNa" value="" />

    <!-- ===== Putanje (relativne = od foldera exe-a) ===== -->
    <add key="PravilaFolder" value="\\192.168.1.6\Cloude\Agenti\CimProvera\pravila" />
    <!-- Verzija pravila je samo u fajlu (meta.version) i u istoriji (pravila\istorija) -->
    <add key="PravilaFajl" value="cim_validation_rules.json" />
    <!-- Raspored rubrika CIM/CUV obrasca, sidra i rečnik naziva rubrika -->
    <add key="SablonFajl" value="sablon\cim_sablon.json" />
    <!-- Šabloni obrazaca (K-504, K-505/2006, ŽS EurologSystem…); novi obrazac: komanda sablon-nacrt -->
    <add key="ObrasciFolder" value="sablon\obrasci" />
    <!-- Režim Test: JSON pročitanih rubrika i slika okvira za svaki list (yyyy-MM-dd podfolder); prazno = ne čuva se -->
    <add key="RezultatiFolder" value="testovi\rezultati" />
    <add key="StanjeFolder" value="stanje" />
    <add key="LogFolder" value="logs" />
    <add key="LogDana" value="90" />

    <!-- ===== Lokalno čitanje: tekst iz PDF-a + Tesseract OCR (bez API ključeva, ništa ne izlazi iz firme) ===== -->
    <add key="TessdataFolder" value="tessdata" />
    <add key="OcrJezici" value="eng+deu+fra+srp_latn+srp" />
    <!-- Drugo čitanje strane sa jezikom zemlje obrasca (prepoznaje se po tekstu: fuvarlevél, kolodvor, товарителница…); svi jezici odjednom kvare OCR -->
    <add key="OcrDodatniJezici" value="hun+ita+ron+bul+slv+hrv" />
    <!-- OCR reči ispod ove pouzdanosti se odbacuju kao šum -->
    <add key="OcrMinPouzdanostReci" value="0.3" />
    <!-- Ispod ovog praga pouzdanosti rubrika se tretira kao nečitljiva (upozorenje + ručna provera), ne kao greška -->
    <add key="PragPouzdanosti" value="0.6" />
    <!-- Poravnanje strane na šablon: najmanji zbir sidara (tekst + brojevi rubrika + linije okvira), najmanje po trećini
         strane, najveće srednje odstupanje (udeo strane) i najmanji udeo tekstualnih sidara koja se slažu -->
    <add key="MinSidara" value="12" />
    <add key="MinSidaraPoTrecini" value="2" />
    <add key="MaxOdstupanjePoravnanja" value="0.006" />
    <add key="MinUdeoTekstualnihSidara" value="0.8" />
    <!-- Mastilo (udeo površine) iznad osnove praznog obrasca: rubrika bez pročitanog teksta je nečitljiva, ne prazna -->
    <add key="PragMastila" value="0.004" />
    <!-- Polja za označavanje (r20, r22, r23, r30, r52, r58b): gustina ≥ PragOznake = označeno, ≤ PragPraznogPolja = prazno, između = nesigurno -->
    <add key="PragOznake" value="0.15" />
    <add key="PragPraznogPolja" value="0.05" />
    <add key="MaxPokusaja" value="5" />
    <add key="MaxPrilogMB" value="30" />

    <!-- CurrentUser (podrazumevano) ili LocalMachine -->
    <add key="DpapiOpseg" value="CurrentUser" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.2" />
  </startup>
  <runtime>
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
